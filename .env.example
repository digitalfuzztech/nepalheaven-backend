# MySQL 8-compatible connection string
DATABASE_URL=mysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME

# Optional Unix socket for production hosts such as Hostinger.
# Leave unset for normal TCP development.
DB_SOCKET_PATH=

# Application
APP_URL=http://localhost:8080

# Email. Local development may use MAIL_MODE=log; production must use smtp.
MAIL_MODE=log
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
# Canonical public and internal routing addresses.
MAIL_INFO_ADDRESS=info@nepalheaven.com
MAIL_ADMIN_ADDRESS=admin@nepalheaven.com
MAIL_JOURNEYS_ADDRESS=journeys@nepalheaven.com
MAIL_BOOKING_ADDRESS=booking@nepalheaven.com
MAIL_REGISTER_ADDRESS=register@nepalheaven.com

# Real authenticated mailboxes. Journeys, bookings and register are aliases of
# MAIL_ADMIN_USER and intentionally have no password variables of their own.
MAIL_INFO_USER=
MAIL_INFO_PASSWORD=
MAIL_ADMIN_USER=
MAIL_ADMIN_PASSWORD=

# Legacy info-mailbox settings retained for backwards compatibility.
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Nepal Heaven
MAIL_ADMIN_TO=
MAIL_REPLY_TO=
# Optional controlled recipient used only by explicit SMTP verification scripts.
MAIL_TEST_TO=
# Optional business address shown in the email footer.
MAIL_BUSINESS_ADDRESS=Kathmandu, Nepal

# Public business WhatsApp number in international format. No API credential.
WHATSAPP_PHONE_NUMBER=977XXXXXXXXXX

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Local development only. Production must use a real verified provider mode.
PAYMENT_MODE=mock

# Optional persistent private storage roots (must remain outside public/).
PRIVATE_DOCUMENT_ROOT=/absolute/private/path/identity-documents
PRIVATE_PROFILE_PHOTO_ROOT=/absolute/private/path/profile-photos
